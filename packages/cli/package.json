{
  "name": "@sovea/stetra",
  "version": "0.0.1",
  "description": "CLI for the Stetra engineering harness for coding agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sovea/stetra.git",
    "directory": "packages/cli"
  },
  "bin": {
    "stetra": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm -w build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.0",
    "@sovea/stetra-core": "workspace:*",
    "commander": "^15.0.0",
    "execa": "^9.6.0",
    "picocolors": "^1.1.1",
    "which": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/which": "^3.0.4",
    "tsdown": "^0.21.8",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
