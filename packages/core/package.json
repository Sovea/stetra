{
  "name": "@sovea/resonant-code-core",
  "version": "0.0.1",
  "description": "Deterministic Playbook, RCCL, compilation, and evaluation kernel for resonant-code.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sovea/resonant-code.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./rccl": {
      "types": "./dist/rccl.d.mts",
      "import": "./dist/rccl.mjs"
    }
  },
  "files": [
    "assets",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/harness.test.ts test/context.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsdown": "^0.21.8",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "yaml": "^2.9.0"
  }
}
