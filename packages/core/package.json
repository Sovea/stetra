{
  "name": "@sovea/stetra-core",
  "version": "0.0.1",
  "description": "Deterministic Semantic Contract and Cognitive Handoff kernel for Stetra.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sovea/stetra.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/semantic-handoff.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsdown": "^0.21.8",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2"
  }
}
