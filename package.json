{
  "name": "resonant-code-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && node skills/code/test/workflow.test.mjs",
    "test:coverage": "c8 pnpm test",
    "verify:dist": "node test/verify-dist.test.mjs",
    "verify:plugin": "node test/verify-plugin.test.mjs && node skills/code/scripts/code.mjs doctor .",
    "verify:smoke": "node test/release-smoke.test.mjs",
    "verify": "pnpm typecheck && pnpm test:coverage && pnpm build && pnpm verify:dist && pnpm verify:smoke && pnpm verify:plugin"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "tsx": "^4.23.1"
  }
}
