{
  "name": "@sovea/stetra",
  "version": "0.1.0",
  "description": "Keep developer intent, engineering choices, and implementation connected inside a coding Host.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sovea/stetra.git"
  },
  "bin": {
    "stetra": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "files": [
    "dist",
    "skills",
    "hooks",
    ".codex-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "verify": "npm run typecheck && npm test && node --test test/package.test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "commander": "^15.0.0",
    "esbuild": "^0.27.0",
    "ink": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  }
}
