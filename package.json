{
  "name": "resonant-code-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test && node skills/code/test/workflow.test.mjs",
    "test:coverage": "c8 corepack pnpm test",
    "verify:dist": "node test/verify-dist.test.mjs",
    "verify:plugin": "node test/verify-plugin.test.mjs && node skills/code/scripts/code.mjs doctor .",
    "verify:smoke": "node test/release-smoke.test.mjs",
    "verify": "corepack pnpm typecheck && corepack pnpm test:coverage && corepack pnpm build && corepack pnpm verify:dist && corepack pnpm verify:smoke && corepack pnpm verify:plugin"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "tsx": "^4.23.1"
  }
}
